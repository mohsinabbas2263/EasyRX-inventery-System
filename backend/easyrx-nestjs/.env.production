# Production Environment Variables
NODE_ENV=production
PORT=3000

# Database
DATABASE_HOST=easyrx-db
DATABASE_PORT=5432
DATABASE_USER=easyrx_admin
DATABASE_PASSWORD=CHANGE_ME_NOW_CRYPTO_SECURE_PASSWORD
DATABASE_NAME=easyrx_prod
DB_LOGGING=false

# Security
JWT_SECRET=CHANGE_ME_NOW_MIN_64_CHARACTERS_LONG_SECRET
ALLOWED_ORIGINS=https://app.easyrx.com,https://pos.easyrx.com

# Redis
REDIS_HOST=easyrx-redis
REDIS_PORT=6379

# Business Rules
NEAR_EXPIRY_DAYS=90
ALLOW_NEGATIVE_STOCK=false
LOG_LEVEL=info
