# Production Environment Configuration Template
# DO NOT COMMIT REAL SECRETS

# Application
NODE_ENV=production
PORT=3000

# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=
DATABASE_NAME=easyrx
DATABASE_SSL=true

# JWT (Use strong keys)
JWT_SECRET=
JWT_EXPIRATION=12h
JWT_REFRESH_EXPIRATION=7d

# CORS (Comma separated allowed origins)
ALLOWED_ORIGINS=https://app.easyrx.com

# Pharmacy Business Rules
NEAR_EXPIRY_DAYS=90
ALLOW_NEGATIVE_STOCK=false

# Rate Limiting
THROTTLE_TTL_SHORT=1000
THROTTLE_LIMIT_SHORT=10
THROTTLE_TTL_LONG=60000
THROTTLE_LIMIT_LONG=1000
